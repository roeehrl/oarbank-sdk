---
// Header brand: the Codonic wordmark (to codonic.dev), then the Oarbank mark and
// "Oarbank docs" (to the docs home). Mirrors codonic.dev's Wordmark component.
import logo from '../../assets/oarbank-logo.svg';
import { BASE, PRODUCT, PUBLISHER } from '../../../site.config.mjs';
---

<div class="brand sl-flex">
  <a class="codonic sl-flex" href={PUBLISHER.url} aria-label="Codonic home">
    <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="9" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.5"></rect>
      <circle cx="10" cy="10" r="2.6" fill="currentColor"></circle>
      <circle cx="16" cy="16" r="2.6" fill="currentColor" fill-opacity="0.62"></circle>
      <circle cx="22" cy="22" r="2.6" fill="currentColor" fill-opacity="0.3"></circle>
      <path d="M10 22 L22 10" stroke="currentColor" stroke-opacity="0.34" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
    <span class="codonic-name">Codonic</span>
  </a>
  <span class="divider" aria-hidden="true"></span>
  <a class="site-title sl-flex" href={`${BASE}/`}>
    <img src={logo.src} width="28" height="28" alt="" />
    <span translate="no">{PRODUCT.docsTitle}</span>
  </a>
</div>

<style>
  .brand {
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .codonic {
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
    flex-shrink: 0;
  }
  .codonic-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.012em;
  }
  .divider {
    width: 1px;
    height: 1.25rem;
    background: var(--sl-color-gray-5);
    flex-shrink: 0;
  }
  .site-title {
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-h5);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-title span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .site-title img {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.4rem;
    flex-shrink: 0;
  }
  @media (max-width: 30rem) {
    .codonic-name {
      display: none;
    }
    .brand {
      gap: 0.5rem;
    }
  }
</style>
