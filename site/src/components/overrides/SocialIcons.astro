---
// Header links: back to the product page on codonic.dev, and GitHub once the
// SDK repository is public.
import { Icon } from '@astrojs/starlight/components';
import { PRODUCT, REPO } from '../../../site.config.mjs';
---

<a class="product" href={PRODUCT.productUrl}>Product</a>
{
  REPO.public && (
    <a class="gh sl-flex" href={REPO.url}>
      <span class="sr-only">GitHub</span>
      <Icon name="github" />
    </a>
  )
}

<style>
  .product {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .product:hover,
  .gh:hover {
    color: var(--sl-color-white);
  }
  .gh {
    color: var(--sl-color-gray-2);
    padding: 0.5em;
    margin: -0.5em;
  }
</style>
