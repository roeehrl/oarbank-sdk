{
  "name": "oarbank-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && astro dev",
    "build": "node scripts/sync-content.mjs && astro build && node scripts/pagefind-urls.mjs && node scripts/md-twins.mjs && node scripts/externalise-scripts.mjs && node scripts/assemble.mjs && node scripts/build-hub.mjs && node scripts/check-dist.mjs",
    "check": "node scripts/sync-content.mjs && astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "build:hub": "node scripts/build-hub.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5",
    "hast-util-select": "6.0.4",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "starlight-links-validator": "0.26.0",
    "starlight-llms-txt": "0.12.0",
    "unified": "11.0.5",
    "unist-util-remove": "4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
