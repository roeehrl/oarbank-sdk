(version 1)
;; oarbank module sandbox, profile 2 (coordinator)
(deny default (with message (param "MODULE_ID")))

;; process
(allow process-fork)
(allow process-exec (subpath "/bin") (subpath "/usr/bin") (subpath "/usr/libexec"))
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow ipc-posix-sem)
(allow ipc-posix-shm-read-data ipc-posix-shm-read-metadata (ipc-posix-name "apple.shm.notification_center"))
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.logd")
  (global-name "com.apple.system.logger"))

;; read-only system
(allow file-read* (literal "/"))
(allow file-read-metadata (literal "/tmp") (literal "/var") (literal "/etc") (literal "/private/var/select/sh"))
(allow file-read* file-map-executable
  (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library/Apple")
  (subpath "/private/var/db/timezone") (subpath "/bin") (subpath "/usr/bin") (subpath "/usr/libexec")
  (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf") (literal "/private/var/run/resolv.conf")
  (literal "/private/var/select/sh") (literal "/private/etc/services") (literal "/private/etc/protocols")
  (literal "/private/etc/localtime") (subpath "/private/etc/ssl")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom")
  (literal "/dev/dtracehelper") (subpath "/dev/fd"))
(allow file-write-data (literal "/dev/null") (literal "/dev/zero") (subpath "/dev/fd"))
(allow file-ioctl (literal "/dev/dtracehelper"))

;; module grants
(allow file-read* file-map-executable process-exec (subpath (param "RO_0")))
(allow file-read-metadata (path-ancestors (param "RO_0")))
(allow file-read* file-map-executable process-exec (subpath (param "RO_1")))
(allow file-read-metadata (path-ancestors (param "RO_1")))
(allow file-read* file-map-executable process-exec (subpath (param "RO_2")))
(allow file-read-metadata (path-ancestors (param "RO_2")))
(allow file-read* file-map-executable process-exec (subpath (param "RO_3")))
(allow file-read-metadata (path-ancestors (param "RO_3")))
(allow file-read* file-write* (subpath (param "RW_0")))
(allow file-read-metadata (path-ancestors (param "RW_0")))
(allow file-read* file-write* (subpath (param "RW_1")))
(allow file-read-metadata (path-ancestors (param "RW_1")))
(allow file-read-metadata (literal (param "LINK_0")))
(allow file-read-metadata (literal (param "LINK_1")))
(allow file-read-metadata (literal (param "LINK_2")))

;; hardening (last match wins: keep after every allow above)
(deny mach-lookup (xpc-service-name-prefix ""))
(deny system-fcntl (fcntl-command 80 110))
