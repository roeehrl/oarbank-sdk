{
  "$id": "https://codonic.dev/oarbank/schemas/module-host-nodes-query-params-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "certified_for_self": {
      "default": true,
      "title": "Certified For Self",
      "type": "boolean"
    },
    "platforms": {
      "description": "[beta] Only nodes of these platforms (tokens or OSes; empty: all).",
      "items": {
        "maxLength": 40,
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9_]+)?$",
        "type": "string"
      },
      "title": "Platforms",
      "type": "array"
    }
  },
  "title": "NodesQueryParams",
  "type": "object"
}
