{
  "$defs": {
    "Issue": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[stable] Module-namespaced reason code, e.g. render/tile_size_order.",
          "title": "Code"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "default": "",
          "description": "[stable] JSON pointer into the input, '' = whole document.",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "$id": "https://codonic.dev/oarbank/schemas/module-params-check-result-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "errors": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Errors",
      "type": "array"
    },
    "normalized_params": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Params"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "title": "ParamsCheckResult",
  "type": "object"
}
