{
  "$defs": {
    "CheckpointFile": {
      "additionalProperties": true,
      "description": "One file of a checkpoint: a regular file in the workdir, and where it appears in the checkpoint. [beta]",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[beta] Where it appears under <W>/checkpoint/ on resume (a PortablePath; default: `path`).",
          "title": "Name"
        },
        "path": {
          "description": "[beta] The workdir file (a PortablePath). Once the event is written it belongs to the agent, which moves it away.",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "CheckpointFile",
      "type": "object"
    }
  },
  "$id": "https://codonic.dev/oarbank/schemas/runner-event-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One NDJSON line in --events (capability progress_events).",
  "properties": {
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "files": {
      "description": "[beta] checkpoint: the checkpoint's files (runner capability `checkpoint`, a stage with `checkpoint`); `data` (at most 4 KiB) comes back in the resumed attempt's spec envelope.",
      "items": {
        "$ref": "#/$defs/CheckpointFile"
      },
      "title": "Files",
      "type": "array"
    },
    "fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "[stable] progress: 0..1.",
      "title": "Fraction"
    },
    "kind": {
      "enum": [
        "log",
        "progress",
        "metric",
        "checkpoint",
        "phase"
      ],
      "title": "Kind",
      "type": "string"
    },
    "level": {
      "anyOf": [
        {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Level"
    },
    "msg": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Msg"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "[stable] metric/phase name.",
      "title": "Name"
    },
    "t": {
      "description": "[stable] Unix seconds.",
      "title": "T",
      "type": "number"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "t",
    "kind"
  ],
  "title": "Event",
  "type": "object"
}
