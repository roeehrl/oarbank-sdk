{
  "$id": "https://codonic.dev/oarbank/schemas/module-rpc-request-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "title": "Id"
    },
    "jsonrpc": {
      "const": "2.0",
      "default": "2.0",
      "title": "Jsonrpc",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    }
  },
  "required": [
    "id",
    "method"
  ],
  "title": "Request",
  "type": "object"
}
